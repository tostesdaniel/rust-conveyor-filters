  "repository": {
    "type": "git",
    "url": "https://github.com/tostesdaniel/rust-conveyor-filters.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:start": "docker run --name pg-conveyor-filters -h 127.0.1.1 -e POSTGRES_PASSWORD=rcfisawesome -p 5433:5432 -v postgres-data:/var/lib/postgresql/data -d postgres:16",
    "db:stop": "docker stop pg-conveyor-filters && docker rm pg-conveyor-filters",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed",
    "db:setup": "bun db:push && bun db:seed",
    "db:studio": "drizzle-kit studio",
    "items:update": "bun run ./src/scripts/items/update.ts",
    "items:icons": "bun run ./src/scripts/items/update-icons.ts",
    "items:upload": "bun run ./src/scripts/items/upload-icons.ts",
    "tags:seed": "bun run ./src/scripts/ai-tags/seed-taxonomy.ts",
    "tags:bootstrap": "bun run ./src/scripts/ai-tags/bootstrap-from-popular.ts",
    "tags:review": "bun run ./src/scripts/ai-tags/review-proposals.ts",
    "tags:backfill": "bun run ./src/scripts/ai-tags/backfill.ts",
    "tags:status": "bun run ./src/scripts/ai-tags/status.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
