{
  "name": "rust-conveyor-filters",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://rustconveyorfilters.com",
  "bugs": {
    "url": "https://github.com/tostesdaniel/rust-conveyor-filters/issues",
    "email": "tostes.dev@gmail.com"
